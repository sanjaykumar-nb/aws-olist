# ---- Where the 9 Olist CSV files are on the host (mounted read-only at /dataset) ----
# EC2 (deploy/ec2-setup.sh puts them here):
OLIST_DATASET_HOST_DIR=/opt/olist/dataset
# Windows example:
# OLIST_DATASET_HOST_DIR=C:/Users/you/Downloads/e-commerse-dataset

# ---- Network ----
OLIST_PORT=8000
# 0.0.0.0 = reachable from outside (restrict with the EC2 security group);
# 127.0.0.1 = host only, when a reverse proxy (Nginx/Caddy) fronts the app
OLIST_BIND=0.0.0.0

# ---- Security ----
# Required for every /api/v1 call except /health when set. Generate one with:
#   openssl rand -hex 24
# Leave empty to disable (only on a private network).
OLIST_API_KEY=

# ---- Streaming ----
# Start the simulator when the container starts (true for an always-on source)
OLIST_AUTOSTART=false
# New orders per second (each order produces ~7 events over its lifecycle)
OLIST_ORDERS_PER_SEC=1
# Delete events older than this many hours; 0 keeps them forever. Your consumer must
# read the event log at least this often or it will miss events.
OLIST_EVENT_RETENTION_HOURS=168
